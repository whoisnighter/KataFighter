<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="katafighter.exe"
        Arguments=""
        InstallLocation="C:\Program Files\KataFighter\KataFighter">
    </Installer>
    <PackageInformation
        PackageName="KataFighter"
        PackageDisplayName="KataFighter"
        PublisherName="CN=KataFighter"
        PublisherDisplayName="KataFighter"
        Version="0.1.0.0"
        PackageDescription="Character editor for Ikemen GO">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.example.katafighter"
                Description="Character editor for Ikemen GO"
                DisplayName="KataFighter"
                ExecutableName="katafighter.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>KataFighter</DisplayName>
            <PublisherDisplayName>KataFighter</PublisherDisplayName>
            <Description>Character editor for Ikemen GO</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="katafighter.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
